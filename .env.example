# Admin UI token — the only credential the UI needs
ADMIN_TOKEN=change-me

# The notebook (required)
# SharePoint site that holds the notebook
SHAREPOINT_SITE=https://your-tenant.sharepoint.com/sites/your-site
# Server-relative folder of the notebook: the folder with its .one section files
NOTEBOOK_PATH=/sites/your-site/Shared Documents/Your Notebook
# The notebook as OneNote for the web opens it
NOTEBOOK_URL=https://your-tenant.sharepoint.com/:o:/r/sites/your-site/Shared%20Documents/Your%20Notebook

# The vault: a git repo of markdown notes (required)
VAULT_REPO=git@github.com:your-account/your-vault.git
#VAULT_DIR=~/vaults/notes     # local clone; /vault in docker
#VAULT_NOTES_DIR=specs        # subfolder the sync owns; nothing outside it is touched
#VAULT_WEB=                   # link shown in the UI; derived from VAULT_REPO when unset
# vault-push deploy key, base64 of the private key file (docker only)
#DEPLOY_KEY_B64=

# Account for in-container re-login (the emailed code comes via the admin UI)
MS_EMAIL=you@example.com
# Optional: only if unattended runs should get past the password step by themselves
#M365_PASSWORD=

# Schedule
#RUN_AT=08:30
#TZ=UTC
